# 1. Razorpay Payment Gateway (Optional - for direct card/UPI/netbanking modal)
# Get from Razorpay Dashboard -> Settings -> API Keys
VITE_RAZORPAY_KEY_ID=

# 2. Google Sheets / Apps Script Webhook (Free & Instant live spreadsheet)
# Paste your deployed Google Apps Script Webhook URL below:
VITE_GOOGLE_SHEETS_WEBHOOK_URL=

# 3. PostgreSQL / Supabase Database (Optional - for direct PostgreSQL tables)
# Get from Supabase Project Settings -> API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
